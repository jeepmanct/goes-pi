[Unit]
Description=goesproc
After=goesrecv.service
Requires=goesrecv.service

[Service]
User=pi
WorkingDirectory=/home/pi/goes
ExecStart=/usr/local/bin/goesproc -c /home/pi/goes/goesproc.conf -m packet --subscribe tcp://127.0.0.1:5004
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
