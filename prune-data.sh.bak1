#!/bin/bash
# Keep ~/goes/data under a 200 GB allocation: once usage reaches 190 GB,
# delete the oldest files (by mtime) until usage is back under 190 GB.
DATA=/home/pi/goes/data
TRIGGER=$((190*1000*1000*1000))
exec 9>/tmp/goes-prune.lock; flock -n 9 || exit 0

used=$(du -sb "$DATA" | cut -f1)
[ "$used" -lt "$TRIGGER" ] && exit 0

find "$DATA" -type f -printf '%T@ %s %p\n' | sort -n | while read -r _ size path; do
  [ "$used" -lt "$TRIGGER" ] && break
  rm -f -- "$path" && used=$((used - size))
done
find "$DATA" -mindepth 1 -type d -empty -delete
logger -t goes-prune "pruned data dir, now $((used/1000000000)) GB"
