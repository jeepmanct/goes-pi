<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GOES Control</title>
<link rel="manifest" href="/manifest.webmanifest">
<link rel="apple-touch-icon" href="/icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="GOES">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<style>
:root {
  --bg: #0e1116; --panel: #171c24; --line: #2a313c; --text: #e6e9ee; --muted: #8a94a3;
  --good: #3ddc84; --warn: #ffb02e; --bad: #ff5c5c; --accent: #5aa9ff;
}
@media (prefers-color-scheme: light) {
  :root { --bg: #f3f5f8; --panel: #fff; --line: #d6dbe3; --text: #14181f; --muted: #5b6573;
          --good: #12985a; --warn: #b86e00; --bad: #d02f2f; --accent: #1566c4; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 16px/1.4 system-ui, sans-serif; }
header { display: flex; align-items: center; gap: 12px; padding: 10px 16px;
  border-bottom: 1px solid var(--line); flex-wrap: wrap; }
header h1 { font-size: 18px; margin: 0; }
.pill { padding: 3px 10px; border-radius: 99px; font-size: 13px; border: 1px solid var(--line); color: var(--muted); }
.pill.on { color: var(--good); border-color: var(--good); }
nav { display: flex; gap: 4px; padding: 8px 16px 0; overflow-x: auto; border-bottom: 1px solid var(--line); }
nav button { background: none; border: 0; color: var(--muted); padding: 10px 14px; font-size: 15px;
  border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; }
nav button.active { color: var(--text); border-bottom-color: var(--accent); }
main { padding: 16px; max-width: 1000px; margin: 0 auto; }
section { display: none; }
section.active { display: block; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px; margin-bottom: 14px; }
.card h2 { margin: 0 0 10px; font-size: 14px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
.banner { text-align: center; font-size: 28px; font-weight: 700; padding: 16px; border-radius: 10px; margin-bottom: 14px; border: 2px solid var(--line); }
.banner.good { color: var(--good); border-color: var(--good); }
.banner.warn { color: var(--warn); border-color: var(--warn); }
.banner.bad { color: var(--bad); border-color: var(--bad); }
.banner small { display: block; font-size: 13px; font-weight: 400; color: var(--muted); }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
.metric { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px; }
.metric .l { font-size: 12px; color: var(--muted); }
.metric .v { font-size: 30px; font-weight: 700; font-variant-numeric: tabular-nums; }
.metric .s { font-size: 12px; color: var(--muted); }
button.b, a.b { background: var(--accent); color: #fff; border: 0; border-radius: 8px; padding: 12px 18px;
  font-size: 16px; cursor: pointer; text-decoration: none; display: inline-block; }
button.b.go { background: var(--good); color: #05210f; }
button.b.stop { background: var(--bad); }
button.b.ghost { background: none; border: 1px solid var(--line); color: var(--text); }
button.b:disabled { opacity: .35; }
.pstate { font-weight: 600; margin: 2px 0 10px; }
.pstate.on { color: var(--good); }
.pstate.off { color: var(--muted); }
.row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
canvas { width: 100%; height: 150px; display: block; }
label { display: block; font-size: 13px; color: var(--muted); margin: 8px 0 3px; }
input, select, textarea { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--line);
  background: var(--bg); color: var(--text); font: inherit; }
textarea { font-family: ui-monospace, monospace; font-size: 13px; min-height: 280px; }
pre { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px; overflow: auto;
  max-height: 420px; font-size: 12px; margin: 0; }
.crumbs a { color: var(--accent); cursor: pointer; }
.files { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
.file { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; font-size: 12px; }
.file img { width: 100%; height: 110px; object-fit: cover; display: block; background: #000; }
.file div { padding: 6px 8px; word-break: break-all; }
.file .m { color: var(--muted); }
.dir { padding: 10px; border: 1px solid var(--line); border-radius: 8px; margin-bottom: 6px; cursor: pointer; display: flex; justify-content: space-between; }
.msg { color: var(--muted); font-size: 14px; min-height: 20px; margin-top: 8px; }
#lightbox { position: fixed; inset: 0; background: rgba(0,0,0,.92); display: none; align-items: center; justify-content: center; flex-direction: column; gap: 10px; z-index: 9; }
#lb-txt { display: none; width: 94vw; max-height: 78vh; overflow: auto; margin: 0; padding: 12px; background: var(--panel); color: var(--text); font-size: 12px; white-space: pre-wrap; border-radius: 8px; }
#lb-wrap { max-width: 100vw; max-height: 80vh; overflow: auto; -webkit-overflow-scrolling: touch; }
#lightbox img { max-width: 96vw; max-height: 78vh; display: block; margin: 0 auto; }
#lightbox img.zoom { max-width: none; max-height: none; width: 250vw; }

#gal { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; margin-top: 12px; }
#gal .g { cursor: pointer; background: var(--panel); border-radius: 8px; overflow: hidden; }
#gal img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; background: #000; }
#gal .cap { padding: 6px 8px; font-size: 12px; line-height: 1.35; }
#gal .cap b { display: block; font-variant-numeric: tabular-nums; }
#gal .cap span { opacity: .65; word-break: break-all; }

#globe-img { width: 100%; display: block; border-radius: 8px; background: #000; cursor: pointer; }
#globe-bar { display: flex; gap: 10px; align-items: center; margin-top: 10px; }
#globe-bar input[type=range] { flex: 1; width: auto; }
#globe-time { font-variant-numeric: tabular-nums; min-width: 9.5em; text-align: right; }
</style>
</head>
<body>
<header>
  <h1>GOES Control</h1>
  <span class="pill" id="p-recv">goesrecv: …</span>
  <span class="pill" id="p-proc">goesproc: …</span>
  <span class="pill" id="p-sys"></span>
</header>
<nav id="tabs"></nav>
<main>

<section id="aim">
  <div class="banner" id="banner">No data<small>Start goesrecv to begin</small></div>
  <div class="card row">
    <button class="b go" id="aim-toggle">Start goesrecv</button>
    <button class="b ghost" id="sound">🔇 Sound off</button>
    <span class="row" style="margin-left:auto">
      Gain <button class="b ghost" id="gain-dn">−</button>
      <b id="gain-val" style="min-width:32px;text-align:center">–</b>
      <button class="b ghost" id="gain-up">+</button>
    </span>
  </div>
  <div class="grid" id="metrics"></div>
  <div class="card" style="margin-top:14px">
    <h2>Viterbi errors (lower is better) – last 2 min</h2>
    <canvas id="c-vit"></canvas>
  </div>
  <div class="card">
    <h2>Packets per second – OK vs dropped</h2>
    <canvas id="c-pkt"></canvas>
  </div>
  <div class="card">
    <h2>Frequency offset (Hz)</h2>
    <canvas id="c-freq"></canvas>
  </div>
  <div class="msg" id="aim-msg"></div>
</section>

<section id="control">
  <div class="card">
    <h2>goesrecv – demodulator</h2>
    <div class="pstate" id="st-goesrecv"></div>
    <div class="row">
      <button class="b go" data-act="goesrecv/start">Start</button>
      <button class="b stop" data-act="goesrecv/stop">Stop</button>
      <button class="b ghost" data-act="goesrecv/restart">Restart</button>
    </div>
  </div>
  <div class="card">
    <h2>goesproc – image decoder</h2>
    <div class="pstate" id="st-goesproc"></div>
    <div class="row">
      <button class="b go" data-act="goesproc/start">Start</button>
      <button class="b stop" data-act="goesproc/stop">Stop</button>
      <button class="b ghost" data-act="goesproc/restart">Restart</button>
    </div>
    <p class="msg">goesproc turns the decoded packets into images. Start goesrecv first.</p>
  </div>
  <div class="card">
    <h2>SDR check</h2>
    <button class="b ghost" id="sdrtest">Detect SDR</button>
    <pre id="sdr-out" style="margin-top:10px;display:none"></pre>
  </div>
  <div class="card">
    <h2>System</h2>
    <div id="sys"></div>
  </div>
  <div class="msg" id="ctl-msg"></div>
</section>

<section id="config">
  <div class="card">
    <h2>Receiver settings</h2>
    <label>Source</label>
    <select id="f-source"><option>rtlsdr</option><option>airspy</option></select>
    <label>Frequency (Hz) – GOES HRIT is 1694100000</label><input id="f-frequency" type="number">
    <label>Sample rate (Hz)</label><input id="f-sample_rate" type="number">
    <label>Gain</label><input id="f-gain" type="number">
    <label>Device index</label><input id="f-device_index" type="number">
    <label>Bias tee (powers the SAWbird+ from an RTL-SDR Blog V3/V4)</label>
    <select id="f-bias_tee"><option value="true">On</option><option value="false">Off</option></select>
    <div class="row" style="margin-top:14px">
      <button class="b" id="save-fields">Save</button>
      <button class="b ghost" id="save-restart">Save &amp; restart goesrecv</button>
    </div>
    <div class="msg" id="cfg-msg"></div>
  </div>
  <div class="card">
    <h2>goesrecv.conf (raw)</h2>
    <textarea id="raw-goesrecv" spellcheck="false"></textarea>
    <div class="row" style="margin-top:10px"><button class="b" data-raw="goesrecv">Save</button></div>
  </div>
  <div class="card">
    <h2>goesproc.conf (raw)</h2>
    <textarea id="raw-goesproc" spellcheck="false"></textarea>
    <div class="row" style="margin-top:10px"><button class="b" data-raw="goesproc">Save</button></div>
    <p class="msg">Saves are checked for valid TOML and the previous file is kept as <code>.bak</code>.</p>
  </div>
</section>

<section id="globe">
  <div class="card row">
    <select id="globe-region" style="width:auto">
      <option value="eastus">East Coast US</option>
      <option value="nyc">New York City area</option>
      <option value="namer">North America</option>
      <option value="gulf">Gulf &amp; Caribbean</option>
      <option value="samer">South America</option>
      <option value="globe">Full disk</option>
      <optgroup label="Night fog (after dark)">
        <option value="fog_eastus">Fog: East Coast US</option>
        <option value="fog_nyc">Fog: New York City area</option>
        <option value="fog_namer">Fog: North America</option>
        <option value="fog_gulf">Fog: Gulf &amp; Caribbean</option>
        <option value="fog_samer">Fog: South America</option>
      </optgroup>
    </select>
    <select id="globe-range" style="width:auto">
      <option value="24">Last 24 hours</option>
      <option value="72">Last 3 days</option>
      <option value="0">All</option>
    </select>
  </div>
  <div class="card">
    <img id="globe-img" alt="GOES-19 view">
    <div id="globe-bar">
      <button class="b" id="globe-play">Play</button>
      <input type="range" id="globe-slider" min="0" max="0" value="0">
      <span class="msg" id="globe-time"></span>
    </div>
    <p class="msg" id="globe-msg"></p>
  </div>
</section>

<section id="gallery">
  <div class="card row">
    <select id="gal-region" style="width:auto"><option value="">All regions</option></select>
    <span class="msg" id="gal-count" style="margin-left:auto"></span>
  </div>
  <div id="gal"></div>
  <div class="row" style="margin-top:14px"><button class="b ghost" id="gal-more" style="display:none">Load more</button></div>
  <p class="msg">Times are shown in your local time zone; the UTC time is in the tooltip. Newest first.</p>
</section>

<section id="images">
  <div class="card">
    <div class="row">
      <div class="crumbs" id="crumbs"></div>
      <span class="msg" id="storage" style="margin-left:auto"></span>
    </div>
  </div>
  <div id="dirs"></div>
  <div class="files" id="files"></div>
  <div class="row" style="margin-top:14px"><a class="b ghost" id="zip" href="#" target="_blank" rel="noopener">Download this folder (zip)</a><span class="msg" id="zip-note" style="display:none">Folder zip download is only available in the Safari browser, not the Home Screen app.</span></div>
</section>

<section id="logs">
  <div class="card row">
    <select id="log-name" style="width:auto"><option>goesrecv</option><option>goesproc</option></select>
    <label style="margin:0;display:flex;gap:6px;align-items:center"><input type="checkbox" id="log-quiet" style="width:auto"> hide stat lines</label>
  </div>
  <pre id="log-out"></pre>
</section>

</main>
<div id="lightbox"><div class="row"><button class="b" id="lb-save">Save</button><button class="b ghost" id="lb-close">Close</button></div><div id="lb-wrap"><img id="lb-img"></div><pre id="lb-txt"></pre><span class="msg" id="lb-hint">Tap the image to zoom. Tap Close to return.</span></div>

<script>
const $ = s => document.querySelector(s);
const api = async (path, body) => {
  const r = await fetch(path, body === undefined ? {} :
    {method: 'POST', body: JSON.stringify(body), headers: {'Content-Type': 'application/json'}});
  return r.json();
};

// ---- tabs
const TABS = [['aim','Aim'],['control','Control'],['config','Config'],['globe','Views'],['gallery','Gallery'],['images','Files'],['logs','Logs']];
TABS.forEach(([id, name]) => {
  const b = document.createElement('button');
  b.textContent = name; b.dataset.tab = id;
  b.onclick = () => show(id);
  $('#tabs').append(b);
});
function show(id) {
  document.querySelectorAll('section').forEach(s => s.classList.toggle('active', s.id === id));
  document.querySelectorAll('nav button').forEach(b => b.classList.toggle('active', b.dataset.tab === id));
  try { localStorage.tab = id; } catch {}
  if (id === 'config') loadConfig();
  if (id === 'images') loadDir(curPath);
  if (id === 'gallery') loadGallery(true);
  if (id === 'globe') loadGlobe();
}
let startTab = 'aim';
try { startTab = localStorage.tab || 'aim'; } catch {}

// ---- status
let status = {};
const fmtBytes = n => n > 1e9 ? (n/1e9).toFixed(1)+' GB' : n > 1e6 ? (n/1e6).toFixed(1)+' MB' : (n/1e3).toFixed(0)+' KB';
async function pollStatus() {
  try {
    status = await api('/api/status');
    for (const [n, el] of [['goesrecv','#p-recv'],['goesproc','#p-proc']]) {
      const s = status[n];
      $(el).textContent = `${n}: ${s.running ? (s.external ? 'running (external)' : 'running') : 'stopped'}`;
      $(el).classList.toggle('on', s.running);
      const up = s.uptime == null ? '' : s.uptime >= 3600 ? ` · up ${Math.floor(s.uptime/3600)} h ${Math.floor(s.uptime%3600/60)} min`
        : s.uptime >= 60 ? ` · up ${Math.floor(s.uptime/60)} min` : ` · up ${Math.round(s.uptime)} s`;
      const st = $('#st-' + n);
      st.textContent = s.running ? `● Running${s.external ? ' (started outside the panel)' : ''}${up}` : '○ Stopped';
      st.className = 'pstate ' + (s.running ? 'on' : 'off');
      document.querySelector(`[data-act="${n}/start"]`).disabled = s.running;
      document.querySelector(`[data-act="${n}/stop"]`).disabled = !s.running;
      document.querySelector(`[data-act="${n}/restart"]`).disabled = !s.running;
    }
    const sy = status.system;
    $('#p-sys').textContent = `${sy.cpu_temp ? sy.cpu_temp.toFixed(0)+'°C · ' : ''}${fmtBytes(sy.disk_free)} free`;
    $('#sys').innerHTML = `CPU temp: ${sy.cpu_temp ?? '?'} °C<br>Load: ${sy.load.toFixed(2)}<br>Disk free: ${fmtBytes(sy.disk_free)} of ${fmtBytes(sy.disk_total)}`;
    const run = status.goesrecv.running;
    const t = $('#aim-toggle');
    t.textContent = run ? 'Stop goesrecv' : 'Start goesrecv';
    t.className = 'b ' + (run ? 'stop' : 'go');
  } catch (e) {}
}
document.addEventListener('click', async e => {
  const a = e.target.dataset.act;
  if (!a) return;
  e.target.disabled = true;
  const r = await api('/api/' + a, {});
  $('#ctl-msg').textContent = `${a}: ${r.result || r.error}`;
  await pollStatus();
});
$('#aim-toggle').onclick = async () => {
  const run = status.goesrecv && status.goesrecv.running;
  $('#aim-toggle').disabled = true;
  const r = await api('/api/goesrecv/' + (run ? 'stop' : 'start'), {});
  $('#aim-msg').textContent = r.result || r.error;
  $('#aim-toggle').disabled = false;
  pollStatus();
};

// ---- aim
const METRICS = [
  ['ok','Packets OK /s',''], ['drops','Dropped /s',''], ['vit','Viterbi err (avg)','lower = better'],
  ['rs','Reed-Solomon (sum)','0 = clean'], ['freq','Freq offset Hz','near 0 when locked'],
  ['omega','Clock omega','steady ≈ locked'], ['gain','Gain','']
];
$('#metrics').innerHTML = METRICS.map(([k,l,s]) =>
  `<div class="metric"><div class="l">${l}</div><div class="v" id="m-${k}">–</div><div class="s" id="ms-${k}">${s}</div></div>`).join('');
let hist = [], lastT = 0, best = {vit: null, ok: 0};
async function pollStats() {
  try {
    const r = await api('/api/stats?since=' + lastT);
    for (const p of r.points) { hist.push(p); lastT = Math.max(lastT, p.t); }
    hist = hist.slice(-120);
    render();
  } catch (e) {}
}
const f = (v, d=0) => v == null ? '–' : v.toFixed(d);
function render() {
  const last = hist[hist.length - 1];
  const age = last ? Date.now()/1000 - last.t : null;
  const live = last && age < 4 && status.goesrecv && status.goesrecv.running;
  const b = $('#banner');
  if (!live) {
    b.className = 'banner'; b.innerHTML = 'No data<small>Start goesrecv to begin</small>';
  } else if (last.ok > 0 && !last.drops) {
    b.className = 'banner good'; b.innerHTML = `DECODING<small>${f(last.ok)} packets/s, no drops</small>`;
  } else if (last.ok > 0) {
    b.className = 'banner warn'; b.innerHTML = `WEAK / INTERMITTENT<small>${f(last.ok)} ok, ${f(last.drops)} dropped per s – keep adjusting</small>`;
  } else {
    b.className = 'banner bad'; b.innerHTML = `NO PACKETS<small>Not decoding yet – keep sweeping the dish</small>`;
  }
  if (!last) return;
  for (const [k] of METRICS) $('#m-'+k).textContent = f(last[k], k === 'omega' ? 3 : k === 'gain' ? 0 : 0);
  $('#gain-val').textContent = f(last.gain);
  if (live) {
    if (last.ok > 0 && (best.vit == null || last.vit < best.vit)) best.vit = last.vit;
    best.ok = Math.max(best.ok, last.ok);
    $('#ms-vit').textContent = best.vit == null ? 'lower = better' : `best this run: ${f(best.vit)}`;
    $('#ms-ok').textContent = `best this run: ${f(best.ok)}`;
    tone(last);
  } else tone(null);
  chart('#c-vit', [{d: hist.map(h => h.vit), c: 'var(--warn)'}]);
  chart('#c-pkt', [{d: hist.map(h => h.ok), c: 'var(--good)'}, {d: hist.map(h => h.drops), c: 'var(--bad)'}]);
  chart('#c-freq', [{d: hist.map(h => h.freq), c: 'var(--accent)'}], true);
}
function chart(sel, series, zero) {
  const cv = $(sel), dpr = devicePixelRatio || 1;
  const w = cv.clientWidth, h = cv.clientHeight;
  cv.width = w * dpr; cv.height = h * dpr;
  const g = cv.getContext('2d'); g.scale(dpr, dpr);
  const css = getComputedStyle(document.documentElement);
  const all = series.flatMap(s => s.d).filter(v => v != null);
  if (!all.length) return;
  let lo = Math.min(...all, zero ? 0 : Infinity), hi = Math.max(...all, zero ? 0 : -Infinity);
  if (!zero) lo = Math.min(lo, 0);
  if (hi === lo) hi = lo + 1;
  const y = v => h - 14 - (v - lo) / (hi - lo) * (h - 24);
  g.strokeStyle = css.getPropertyValue('--line'); g.fillStyle = css.getPropertyValue('--muted'); g.font = '11px sans-serif';
  g.beginPath(); g.moveTo(0, y(lo)); g.lineTo(w, y(lo)); g.stroke();
  g.fillText(hi.toFixed(0), 2, 10); g.fillText(lo.toFixed(0), 2, h - 2);
  for (const s of series) {
    g.strokeStyle = css.getPropertyValue(s.c.slice(4, -1)); g.lineWidth = 2; g.beginPath();
    let started = false;
    s.d.forEach((v, i) => {
      if (v == null) { started = false; return; }
      const x = i / Math.max(119, s.d.length - 1) * w;
      started ? g.lineTo(x, y(v)) : g.moveTo(x, y(v)); started = true;
    });
    g.stroke();
  }
}

// ---- audio aiming aid: pitch rises as packets decode and viterbi errors fall
let actx, osc, gainNode, soundOn = false;
$('#sound').onclick = () => {
  soundOn = !soundOn;
  $('#sound').textContent = soundOn ? '🔊 Sound on' : '🔇 Sound off';
  if (soundOn && !actx) {
    actx = new (window.AudioContext || window.webkitAudioContext)();
    osc = actx.createOscillator(); gainNode = actx.createGain(); gainNode.gain.value = 0;
    osc.connect(gainNode).connect(actx.destination); osc.start();
  }
  if (actx) actx.resume();
  if (!soundOn && gainNode) gainNode.gain.value = 0;
};
function tone(p) {
  if (!soundOn || !osc) return;
  if (!p) { gainNode.gain.value = 0; return; }
  const vits = hist.map(h => h.vit).filter(v => v != null);
  const lo = Math.min(...vits), hi = Math.max(...vits);
  const q = hi > lo ? 1 - (p.vit - lo) / (hi - lo) : 0.5;      // 0 worst .. 1 best (relative)
  const base = p.ok > 0 ? 500 : 200;                            // decoding = higher register
  osc.frequency.value = base + q * 600;
  gainNode.gain.value = 0.15;
}

$('#gain-up').onclick = () => bump(+1); $('#gain-dn').onclick = () => bump(-1);
async function bump(d) {
  const cur = Number($('#gain-val').textContent);
  if (isNaN(cur)) return;
  $('#aim-msg').textContent = 'Applying gain…';
  const r = await api('/api/config/fields', {fields: {gain: cur + d}, restart: true});
  $('#aim-msg').textContent = r.result || r.error;
  hist = []; lastT = Date.now() / 1000; best = {vit: null, ok: 0};
}

// ---- config
async function loadConfig() {
  const c = await api('/api/config');
  for (const [k, v] of Object.entries(c.fields)) { const el = $('#f-' + k); if (el && v != null) el.value = String(v); }
  $('#raw-goesrecv').value = c.goesrecv; $('#raw-goesproc').value = c.goesproc;
}
async function saveFields(restart) {
  const fields = {};
  for (const k of ['source','frequency','sample_rate','gain','device_index','bias_tee']) fields[k] = $('#f-' + k).value;
  const r = await api('/api/config/fields', {fields, restart});
  $('#cfg-msg').textContent = r.result || r.error;
  loadConfig();
}
$('#save-fields').onclick = () => saveFields(false);
$('#save-restart').onclick = () => saveFields(true);
document.querySelectorAll('[data-raw]').forEach(b => b.onclick = async () => {
  const w = b.dataset.raw;
  const r = await api('/api/config/raw', {which: w, text: $('#raw-' + w).value});
  $('#cfg-msg').textContent = r.result || r.error;
  alert(r.result || r.error);
});
$('#sdrtest').onclick = async () => {
  const out = $('#sdr-out'); out.style.display = 'block'; out.textContent = 'Checking…';
  const r = await api('/api/sdrtest', {});
  out.textContent = (r.usb.length ? r.usb.join('\n') : 'No RTL-SDR or Airspy found on USB.') +
    (r.rtl_test ? '\n\n' + r.rtl_test : '');
};

// ---- views (regional crops + time-lapse)
let globeFrames = [], globeTimer = null, globeLoadId = 0;
const gUrl = x => '/file/' + x.path.split('/').map(encodeURIComponent).join('/');
function showGlobe(i) {
  const x = globeFrames[i]; if (!x) return;
  $('#globe-slider').value = i;
  $('#globe-img').src = gUrl(x);
  const d = new Date(x.t * 1000);
  $('#globe-time').textContent = d.toLocaleDateString([], {month: 'short', day: 'numeric'}) + ' ' +
    d.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'});
}
function stopGlobe() { clearInterval(globeTimer); globeTimer = null; $('#globe-play').textContent = 'Play'; }
async function loadGlobe() {
  stopGlobe();
  const id = ++globeLoadId;
  const d = await api('/api/gallery?region=' + $('#globe-region').value + '&limit=200');
  if (id !== globeLoadId) return;
  const hrs = +$('#globe-range').value, cut = hrs ? Date.now() / 1000 - hrs * 3600 : 0;
  globeFrames = d.items.filter(x => x.t >= cut).reverse();   // oldest -> newest
  $('#globe-slider').max = Math.max(globeFrames.length - 1, 0);
  $('#globe-msg').textContent = globeFrames.length
    ? `${globeFrames.length} frame${globeFrames.length > 1 ? 's' : ''}. Tap the picture to zoom or save it.`
    : ($('#globe-region').value.startsWith('fog_')
        ? 'No fog images yet. They are only made when part of the region is in darkness and the infrared channels have arrived.'
        : 'No images for this view and time range yet. New ones are built every few minutes as full-disk scans arrive.');
  $('#globe-img').style.display = globeFrames.length ? '' : 'none';
  if (globeFrames.length) showGlobe(globeFrames.length - 1);
}
$('#globe-region').onchange = loadGlobe;
$('#globe-range').onchange = loadGlobe;
$('#globe-slider').oninput = e => { stopGlobe(); showGlobe(+e.target.value); };
$('#globe-img').onclick = () => { const x = globeFrames[+$('#globe-slider').value]; if (x) lightbox(gUrl(x)); };
$('#globe-play').onclick = async () => {
  if (globeTimer) return stopGlobe();
  if (globeFrames.length < 2) return;
  const id = globeLoadId, btn = $('#globe-play');
  btn.disabled = true;
  let n = 0;                                    // fetch every frame first so playback is smooth
  await Promise.all(globeFrames.map(x => new Promise(res => {
    const im = new Image();
    im.onload = im.onerror = () => { $('#globe-msg').textContent = `Loading ${++n} / ${globeFrames.length}…`; res(); };
    im.src = gUrl(x);
  })));
  btn.disabled = false;
  if (id !== globeLoadId) return;
  $('#globe-msg').textContent = `${globeFrames.length} frames. Tap the picture to zoom or save it.`;
  btn.textContent = 'Pause';
  let i = +$('#globe-slider').value >= globeFrames.length - 1 ? 0 : +$('#globe-slider').value;
  showGlobe(i);
  globeTimer = setInterval(() => { i = (i + 1) % globeFrames.length; showGlobe(i); }, 300);
};

// ---- gallery
let galOff = 0;
const GAL_N = 60;
async function loadGallery(reset) {
  if (reset) { galOff = 0; $('#gal').innerHTML = ''; }
  const reg = $('#gal-region').value;
  const d = await api(`/api/gallery?offset=${galOff}&limit=${GAL_N}&region=${encodeURIComponent(reg)}`);
  d.items.forEach(x => {
    if (reset && !reg && ![...$('#gal-region').options].some(o => o.value === x.region)) {
      $('#gal-region').add(new Option(x.region, x.region));
    }
    const dt = new Date(x.t * 1000);
    const u = '/file/' + x.path.split('/').map(encodeURIComponent).join('/');
    const el = document.createElement('div'); el.className = 'g';
    el.title = dt.toISOString().replace('T', ' ').slice(0, 19) + ' UTC\n' + x.name;
    el.innerHTML = `<img loading="lazy" src="/thumb/${u.slice(6)}"><div class="cap"><b>${dt.toLocaleDateString([], {month: 'short', day: 'numeric'})} ${dt.toLocaleTimeString([], {hour: '2-digit', minute: '2-digit'})}</b><span>${x.region}${x.chan ? " · ch " + x.chan : ""}</span></div>`;
    el.onclick = () => lightbox(u);
    $('#gal').append(el);
  });
  galOff += d.items.length;
  $('#gal-count').textContent = d.total ? `${galOff} of ${d.total} images` : 'No images yet';
  $('#gal-more').style.display = galOff < d.total ? '' : 'none';
}
$('#gal-more').onclick = () => loadGallery(false);
$('#gal-region').onchange = () => loadGallery(true);

// ---- images
let curPath = '';
async function loadDir(p) {
  curPath = p;
  const d = await api('/api/files?path=' + encodeURIComponent(p));
  const parts = p ? p.split('/') : [];
  $('#crumbs').innerHTML = '<a data-p="">data</a>' + parts.map((s, i) =>
    ` / <a data-p="${parts.slice(0, i + 1).join('/')}">${s}</a>`).join('');
  $('#crumbs').querySelectorAll('a').forEach(a => a.onclick = () => loadDir(a.dataset.p));
  $('#dirs').innerHTML = '';
  d.dirs.forEach(x => {
    const el = document.createElement('div'); el.className = 'dir';
    el.innerHTML = `<span>📁 ${x.name}</span><span class="m">${new Date(x.mtime*1000).toLocaleString()}</span>`;
    el.onclick = () => loadDir(x.path); $('#dirs').append(el);
  });
  $('#files').innerHTML = '';
  d.files.slice(0, 200).forEach(x => {
    const el = document.createElement('div'); el.className = 'file';
    const u = '/file/' + x.path.split('/').map(encodeURIComponent).join('/');
    el.innerHTML = (x.image ? `<img loading="lazy" src="/thumb/${u.slice(6)}">` : '') +
      `<div>${x.name}<div class="m">${fmtBytes(x.size)} · ${new Date(x.mtime*1000).toLocaleTimeString()}</div></div>`;
    el.onclick = () => x.image ? lightbox(u) : textViewer(u);
    $('#files').append(el);
  });
  if (d.files.length > 200) $('#files').insertAdjacentHTML('beforeend', `<p class="msg">Showing 200 of ${d.files.length}.</p>`);
  $('#zip').href = '/zip?path=' + encodeURIComponent(p);
  api('/api/storage').then(s => $('#storage').textContent = 'Total stored: ' + fmtBytes(s.bytes));
}
let lbUrl = '';
function lightbox(u) {
  lbUrl = u;
  $('#lb-txt').style.display = 'none'; $('#lb-wrap').style.display = ''; $('#lb-hint').style.display = '';
  $('#lb-img').classList.remove('zoom'); $('#lb-img').src = u;
  $('#lightbox').style.display = 'flex';
}
async function textViewer(u) {
  lbUrl = u;
  $('#lb-wrap').style.display = 'none'; $('#lb-hint').style.display = 'none';
  $('#lb-txt').style.display = 'block'; $('#lb-txt').textContent = 'Loading…';
  $('#lightbox').style.display = 'flex';
  try { $('#lb-txt').textContent = await (await fetch(u)).text(); }
  catch { $('#lb-txt').textContent = 'Could not load file.'; }
}
$('#lb-img').onclick = () => $('#lb-img').classList.toggle('zoom');
$('#lb-save').onclick = async () => {
  const b = $('#lb-save'); b.disabled = true;
  try {
    const blob = await (await fetch(lbUrl)).blob();
    const name = decodeURIComponent(lbUrl.split('/').pop());
    const f = new File([blob], name, {type: blob.type});
    if (navigator.canShare && navigator.canShare({files: [f]})) await navigator.share({files: [f]});
    else $('#lb-hint').textContent = 'Sharing needs HTTPS (open the ts.net address). Or touch and hold the image to save it.';
  } catch (e) { /* share sheet dismissed */ }
  b.disabled = false;
};
$('#lb-close').onclick = () => $('#lightbox').style.display = 'none';

// ---- logs
async function pollLog() {
  if (!$('#logs').classList.contains('active')) return;
  const r = await api(`/api/log?name=${$('#log-name').value}${$('#log-quiet').checked ? '&quiet=1' : ''}`);
  const out = $('#log-out'), atEnd = out.scrollTop + out.clientHeight >= out.scrollHeight - 20;
  out.textContent = r.lines.join('\n');
  if (atEnd) out.scrollTop = out.scrollHeight;
}

if (navigator.standalone || matchMedia('(display-mode: standalone)').matches) {
  $('#zip').style.display = 'none'; $('#zip-note').style.display = '';
}
show(startTab);
pollStatus(); setInterval(pollStatus, 3000);
setInterval(pollStats, 1000);
setInterval(pollLog, 2000);
</script>
</body>
</html>
