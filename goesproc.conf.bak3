# GOES-19 (GOES-East) full disk, all channels
[[handler]]
type = "image"
origin = "goes19"
region = "fd"
directory = "/home/pi/goes/data/goes19/fd/{time:%Y-%m-%d}"

# GOES-19 mesoscale regions
[[handler]]
type = "image"
origin = "goes19"
region = "m1"
directory = "/home/pi/goes/data/goes19/m1/{time:%Y-%m-%d}"

[[handler]]
type = "image"
origin = "goes19"
region = "m2"
directory = "/home/pi/goes/data/goes19/m2/{time:%Y-%m-%d}"

# Weather text and EMWIN products
[[handler]]
type = "text"
origin = "nws"
directory = "/home/pi/goes/data/text/nws"

[[handler]]
type = "text"
origin = "other"
directory = "/home/pi/goes/data/text/other"

[[handler]]
type = "emwin"
directory = "/home/pi/goes/data/emwin"
