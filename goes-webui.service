[Unit]
Description=GOES control panel
After=network.target

[Service]
User=pi
Environment=GOES_UI_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
WorkingDirectory=/home/pi/goes/webui
ExecStart=/usr/bin/python3 -I /home/pi/goes/webui/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
